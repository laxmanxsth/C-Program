#include<stdio.h>
#include<stdlib.h>

// Function to allocate memory
int** allocate(int rows, int cols) {
    int** mat = (int**)malloc(rows * sizeof(int*));
    for(int i = 0; i < rows; i++)
        mat[i] = (int*)malloc(cols * sizeof(int));
    return mat;
}

// Function to input matrix
void input(int** mat, int rows, int cols) {
    for(int i = 0; i < rows; i++)
        for(int j = 0; j < cols; j++)
            scanf("%d", &mat[i][j]);
}

// Function to multiply matrices
int** multiply(int** a, int** b, int r1, int c1, int c2) {
    int** result = allocate(r1, c2);
    
    for(int i = 0; i < r1; i++)
        for(int j = 0; j < c2; j++) {
            result[i][j] = 0;
            for(int k = 0; k < c1; k++)
                result[i][j] += a[i][k] * b[k][j];
        }
    return result;
}

// Function to display matrix
void display(int** mat, int rows, int cols) {
    for(int i = 0; i < rows; i++) {
        for(int j = 0; j < cols; j++)
            printf("%d ", mat[i][j]);
        printf("\n");
    }
}

// Function to free memory
void freeMatrix(int** mat, int rows) {
    for(int i = 0; i < rows; i++)
        free(mat[i]);
    free(mat);
}

int main() {
    int r1, c1, r2, c2;
    
    printf("Enter rows and columns of first matrix: ");
    scanf("%d %d", &r1, &c1);
    
    printf("Enter rows and columns of second matrix: ");
    scanf("%d %d", &r2, &c2);
    
    if(c1 != r2) {
        printf("Multiplication not possible!\n");
        return 0;
    }
    
    int **a = allocate(r1, c1);
    int **b = allocate(r2, c2);
    
    printf("Enter first matrix:\n");
    input(a, r1, c1);
    
    printf("Enter second matrix:\n");
    input(b, r2, c2);
    
    int **result = multiply(a, b, r1, c1, c2);
    
    printf("Product:\n");
    display(result, r1, c2);
    
    freeMatrix(a, r1);
    freeMatrix(b, r2);
    freeMatrix(result, r1);
    
    return 0;
}